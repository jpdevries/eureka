# An S3-compatible bucket as a demo media source (spec 11). One source per file: .env, .env.r2, .env.minio, …
# Copy to apps/demo/.env (gitignored) and fill in. Never commit the real file.
EUREKA_S3_BUCKET=
EUREKA_S3_NAME=bucket
# AWS: leave the region blank to let the bucket's redirect fill it in; set EUREKA_S3_ENDPOINT for R2, MinIO, B2, …
EUREKA_S3_REGION=
EUREKA_S3_ENDPOINT=
# Confine the source to a folder of the bucket, e.g. assets/images
EUREKA_S3_PREFIX=
# A public bucket or CDN URL lets entries link straight to it instead of proxying through the demo server
EUREKA_S3_PUBLIC_URL=
# 1 when the key pair can only read: no upload, rename or delete controls are offered for this source
EUREKA_S3_READ_ONLY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- or a Google Drive source instead (one source per file; spec 11 §4) ---
# A folder id from the Drive URL, or `root` for the account's My Drive; or EUREKA_GDRIVE_DRIVE=<shared drive id>
EUREKA_GDRIVE_FOLDER=
EUREKA_GDRIVE_NAME=drive
EUREKA_GDRIVE_READ_ONLY=
# Service account: the JSON key file (path relative to apps/demo) …
GOOGLE_APPLICATION_CREDENTIALS=
# … or its two fields inline (the private key with \n escapes), optionally impersonating a Workspace user
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATE=
# Or a user's OAuth refresh token from a one-time consent flow
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
