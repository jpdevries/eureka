# An S3-compatible bucket as a demo media source (spec 11). One source per file: .env, .env.r2, .env.minio, …
# Copy to apps/demo/.env (gitignored) and fill in. Never commit the real file.
EUREKA_S3_BUCKET=
EUREKA_S3_NAME=bucket
# AWS: leave the region blank to let the bucket's redirect fill it in; set EUREKA_S3_ENDPOINT for R2, MinIO, B2, …
EUREKA_S3_REGION=
EUREKA_S3_ENDPOINT=
# Confine the source to a folder of the bucket, e.g. assets/images
EUREKA_S3_PREFIX=
# A public bucket or CDN URL lets entries link straight to it instead of proxying through the demo server
EUREKA_S3_PUBLIC_URL=
# 1 when the key pair can only read: no upload, rename or delete controls are offered for this source
EUREKA_S3_READ_ONLY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
