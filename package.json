{
  "name": "eureka-monorepo",
  "private": true,
  "description": "Eureka media browser v3: spec, core, element and reference server",
  "license": "BSD-3-Clause",
  "author": {
    "name": "JP de Vries",
    "email": "mail@devries.jp",
    "url": "https://devries.jp/"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "spec/conformance"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/core packages/server-node",
    "conformance": "npm run test:v2 --workspace spec/conformance",
    "validate:schemas": "npm run validate:schemas --workspace spec/conformance",
    "sync:spec-data": "node scripts/sync-spec-data.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
