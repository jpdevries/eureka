{
  "name": "eureka-monorepo",
  "private": true,
  "description": "Eureka media browser v3: spec, core, element and reference server",
  "license": "BSD-3-Clause",
  "author": {
    "name": "JP de Vries",
    "email": "mail@devries.jp",
    "url": "https://devries.jp/"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "spec/conformance"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/core packages/html packages/element packages/react packages/server-node && tsc -p apps/demo",
    "conformance": "npm run test:v2 --workspace spec/conformance",
    "conformance:v3": "npm run test:v3 --workspace spec/conformance",
    "validate:schemas": "npm run validate:schemas --workspace spec/conformance",
    "sync:spec-data": "node scripts/sync-spec-data.mjs",
    "demo": "npm run build --workspace apps/demo && npm start --workspace apps/demo",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrktps/eureka.git"
  }
}
