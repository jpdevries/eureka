{
  "name": "@mrktps/eureka-react",
  "version": "3.0.0-alpha.1",
  "description": "Typed React wrapper over the <eureka-browser> custom element: props, events as handlers, and a hook that reads the browser's state",
  "keywords": [
    "eureka",
    "media browser",
    "file browser",
    "media library",
    "progressive enhancement",
    "accessibility",
    "custom element",
    "web component",
    "react"
  ],
  "license": "BSD-3-Clause",
  "author": {
    "name": "JP de Vries",
    "email": "mail@devries.jp",
    "url": "https://devries.jp/"
  },
  "homepage": "https://github.com/mrktps/eureka/tree/v3/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrktps/eureka.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/mrktps/eureka/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./dist/jsx.js",
    "./src/jsx.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@mrktps/eureka-core": "3.0.0-alpha.1",
    "@mrktps/eureka": "3.0.0-alpha.1"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0"
  }
}
